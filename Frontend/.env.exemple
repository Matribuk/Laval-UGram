# Frontend Environment Variables
# Copier ce fichier en .env et décommenter la configuration appropriée

# ========================================
# DÉVELOPPEMENT LOCAL (décommenter)
# ========================================
REACT_APP_API_URL=http://localhost:8080

# ========================================
# PRODUCTION AWS (décommenter pour déploiement)
# ========================================
# REACT_APP_API_URL=http://your-backend-url.us-east-1.elasticbeanstalk.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Database Configuration (AWS RDS - Production)
# Décommenter pour utiliser AWS RDS
# DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=your-rds-password
# DB_DATABASE=ugram

# Database Configuration (Docker Local - Development)
# Décommenter pour utiliser la DB locale (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=ugram

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Storage Configuration
# Local storage (development)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# AWS S3 Storage (production)
# Décommenter pour utiliser S3
# STORAGE_TYPE=s3
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=ugram-images-prod-team12
# Note: Les credentials AWS sont automatiquement détectés depuis l'environnement EC2/EB